# Network
FLOCK_SIGNAL_BIND=0.0.0.0:8080

# PostgreSQL - replace with a secret-managed production value.
FLOCK_SIGNAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/flock_signal

# Evidence signing keys are intentionally not embedded here.
# Integrate production signing with the deploying organization's key/secret manager.

# Research identity resolution is not activated by this configuration file.
# The shipping gateway contains no production identity resolver.
