# Development/demo values only. Replace all secrets before deployment.
FLOCK_SIGNAL_API_TOKEN=replace-with-a-random-secret
FLOCK_SIGNAL_PORT=8080
FLOCK_SIGNAL_BIND=0.0.0.0:8080
FLOCK_SIGNAL_DATABASE_URL=postgresql://flock_signal:replace-me@localhost:5432/flock_signal
POSTGRES_DB=flock_signal
POSTGRES_USER=flock_signal
POSTGRES_PASSWORD=replace-me

# Research remains disabled in production by default.
FLOCK_SIGNAL_RESEARCH_ENABLED=false
